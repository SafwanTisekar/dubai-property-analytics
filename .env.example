# Copy to .env and fill in. .env is gitignored — never commit real passwords.

# Application connection (Python + dbt) — the pipeline owner role
PG_HOST=localhost
PG_PORT=5432
PG_DB=dubai_property
PG_USER=dpa_owner
PG_PASSWORD=

# Read-only role used by Power BI (reads rpt.* only)
PBI_READER_PASSWORD=

# Superuser used only by `make db` to create the database and roles.
# Homebrew Postgres: your macOS username. CI / Docker: postgres.
PG_ADMIN_USER=

# dbt
DBT_THREADS=4
