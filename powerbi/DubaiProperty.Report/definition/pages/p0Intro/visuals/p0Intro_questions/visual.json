                      "fontSize": "10pt",
                      "color": "#1b2a4a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  How much rent does a home earn for its price?",
                    "textStyle": {
                      "fontSize": "10pt",
