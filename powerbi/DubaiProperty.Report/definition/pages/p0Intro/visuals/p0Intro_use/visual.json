  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to use it",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1b2a4a",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Use the dark side bar on the left to move between pages.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1b2a4a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The boxes at the top of a page are filters. Pick a year, an area,",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1b2a4a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "    a property type or bedrooms, and the whole page updates.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1b2a4a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Reset all filters clears your choices.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1b2a4a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The ⓘ button opens the KPI guide, which explains every number.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1b2a4a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Hover over a chart to see exact values.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1b2a4a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Illustrative means a what-if exercise, not an official test.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1b2a4a"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
