{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "displayName": "Reset KPI guide",
  "name": "bmP7GuideReset",
  "options": {
    "targetVisualNames": [
      "p7Guide_Page"
    ],
    "applyOnlyToTargetVisuals": true,
    "suppressDisplay": true
  },
  "explorationState": {
    "version": "1.3",
    "activeSection": "p7Guide",
    "sections": {
      "p7Guide": {
        "visualContainers": {
          "p7Guide_Page": {
            "singleVisual": {
              "visualType": "slicer",
              "objects": {
                "remove": [
                  {
                    "object": "general",
                    "property": "filter"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
