// Power BI measures of the Dubai property report, exported from the semantic model
// (powerbi/DubaiProperty.SemanticModel/definition/tables/_Measures.tmdl) by
// `make pbi-measures`. A read-only review copy: edit the TMDL (or Power BI Desktop),
// not this file. tests/test_powerbi_model.py fails when the two drift apart.

// ---------- Report ----------

// Min-n rule (CLAUDE.md): no median, yield or index point from fewer than this many observations.
// Format: 0
[Min N] = MAX ( 'Report Info'[Min N] )

// Header text: the data snapshot date (latest transaction date).
[Data As Of Label] = "Data as of " & FORMAT ( MAX ( 'Report Info'[Data As Of] ), "d mmm yyyy" )

// Footer text: the licence attributions (DLD CC BY 4.0; OpenStreetMap ODbL for the map).
[Footer Attribution] = "Source: " & MAX ( 'Report Info'[Source] ) & "  ·  " & MAX ( 'Report Info'[Map Attribution] )

// The Year slicer as text for titles: one year, or 'all years'.
[Selected Year Label] = IF ( HASONEVALUE ( 'Date'[Year] ), FORMAT ( VALUES ( 'Date'[Year] ), "0" ), "all years" )

// Label required on every stress visual (docs/06 §3).
[Stress Disclaimer] = "Illustrative, not a regulatory stress test. Assumed LTVs; loans held at origination (no amortisation)."

// Page 1 insight title (findings §Executive summary 1).
[Title Executive] = "Dubai recorded " & FORMAT ( [Market Sales], "#,0" ) & " market sales worth AED " & FORMAT ( [Market Sales Value] / 1e9, "#,0.0" ) & "bn in " & [Selected Year Label]

// Off-plan is most sales but not most value (findings 4).
[Title Off-Plan] = "Off-plan was " & FORMAT ( [Off-Plan Share (Count)], "0%" ) & " of market sales but " & FORMAT ( [Off-Plan Share (Value)], "0%" ) & " of their value in " & [Selected Year Label]

// Bank financing of ready purchases (findings 5).
[Title Financing] = "At least " & FORMAT ( [Purchase Mortgage Share], "0.0%" ) & " of ready purchases in " & [Selected Year Label] & " had a matched mortgage"

// Like-for-like price change of the selected index segment.
[Title Prices] = [Selected Index Segment] & ": prices " & FORMAT ( [Index YoY], "+0.0%;-0.0%" ) & " like for like on a year earlier (" & FORMAT ( [Index Latest Complete Period], "mmm yyyy" ) & ")"

// Headline gross yields (reports/yields.md).
[Title Yields] = "Gross yields, last four quarters: apartments " & FORMAT ( CALCULATE ( [Gross Yield (Latest 4 Quarters)], 'Property Type'[Property Type Key] = 101 ), "0.0%" ) & ", villas " & FORMAT ( CALCULATE ( [Gross Yield (Latest 4 Quarters)], 'Property Type'[Property Type Key] = 102 ), "0.0%" )

// AVM vs the comparable-sales baseline (model card).
[Title Valuation] = "AVM median error " & FORMAT ( [AVM Test MdAPE], "0.0%" ) & " vs " & FORMAT ( [AVM Test MdAPE (Baseline)], "0.0%" ) & " for comparable sales (2025-26 test)"

// Stress headline for the slicer state (findings F4c.1).
[Title Stress] = "At " & [Selected LTV] & "% LTV, a " & ABS ( [Selected Shock] ) & "% fall puts " & FORMAT ( [Negative Equity Share], "0%" ) & " of recent " & LOWER ( [Selected Ready / Off-Plan] ) & " buyers in negative equity – " & [Selected Stress Segment]

// Concentration proxy headline (master projects, not developers).
[Title Concentration] = "Top 5 master projects (top 10: " & FORMAT ( [Top 10 Master Project Share (Off-Plan)], "0%" ) & ", HHI " & FORMAT ( [Master Project HHI (Off-Plan)], "#,0" ) & ")"

// Outlook headline for the selected segment and scenario (reports/forecast.md).
[Title Outlook] = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" ) & ": " & FORMAT ( [Forecast 12M Change], "+0.0%;-0.0%" ) & " in 12m (80%: " & [Forecast 12M Band 80% Label] & ")"

// Page 1 insight: off-plan share of sales by number and by value in the last complete year, Dubai-wide (slicers ignored).
[Insight Off-Plan] =
    VAR _year = YEAR ( MAX ( 'Report Info'[Data As Of] ) ) - 1
    VAR _count = CALCULATE ( [Off-Plan Share (Count)], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _year )
    VAR _value = CALCULATE ( [Off-Plan Share (Value)], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _year )
    RETURN
        "In " & _year & ", off-plan homes were " & FORMAT ( _count, "0%" ) & " of market sales but only "
            & FORMAT ( _value, "0%" ) & " of the money spent: off-plan homes are cheaper on average."

// Page 1 insight: market sales from January to the last complete month against the same months a year earlier, ready and off-plan separately, Dubai-wide (slicers ignored).
[Insight Year to Date] =
    VAR _asOf = MAX ( 'Report Info'[Data As Of] )
    VAR _end = EOMONTH ( _asOf, -1 )
    VAR _year = YEAR ( _end )
    VAR _endPrev = EOMONTH ( DATE ( _year - 1, MONTH ( _end ), 1 ), 0 )
    VAR _now = CALCULATE ( [Market Sales], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], DATE ( _year, 1, 1 ), _end ) )
    VAR _prev = CALCULATE ( [Market Sales], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], DATE ( _year - 1, 1, 1 ), _endPrev ) )
    VAR _readyNow = CALCULATE ( [Ready Market Sales], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], DATE ( _year, 1, 1 ), _end ) )
    VAR _readyPrev = CALCULATE ( [Ready Market Sales], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], DATE ( _year - 1, 1, 1 ), _endPrev ) )
    VAR _offNow = CALCULATE ( [Off-Plan Sales], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], DATE ( _year, 1, 1 ), _end ) )
    VAR _offPrev = CALCULATE ( [Off-Plan Sales], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], DATE ( _year - 1, 1, 1 ), _endPrev ) )
    VAR _change = DIVIDE ( _now - _prev, _prev )
    RETURN
        "From January to " & FORMAT ( _end, "mmmm" ) & " " & _year & ", market sales were " & FORMAT ( ABS ( _change ), "0%" )
            & IF ( _change < 0, " lower", " higher" ) & " than a year earlier. Ready homes "
            & FORMAT ( DIVIDE ( _readyNow - _readyPrev, _readyPrev ), "+0%;-0%" ) & ", off-plan "
            & FORMAT ( DIVIDE ( _offNow - _offPrev, _offPrev ), "+0%;-0%" ) & "."

// ---------- Market ----------

// How many property sales happened on the open market. Calculation: count of market sales. Source: Area Month. Caveat: excludes gifts, inheritances, grants and mortgage registrations.
// Format: #,0
[Market Sales] = SUM ( 'Area Month'[Market Sales] )

// The total money spent on homes and other property bought on the open market. Calculation: sum of sale prices, each deal counted once (a deal that covers many units is not repeated). Source: Area Month. Caveat: gifts, inheritances and mortgages are not sales and are left out; amounts are not adjusted for inflation.
// Format: "AED "#,0
[Market Sales Value] = SUM ( 'Area Month'[Market Sales Value AED] )

// Market sales value in the same period a year earlier.
// Format: "AED "#,0
[Market Sales Value PY] = CALCULATE ( [Market Sales Value], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )

// Change in market sales value on the same period a year earlier.
// Format: +0.0%;-0.0%;0.0%
[Market Sales Value YoY %] =
    VAR _cy = [Market Sales Value]
    VAR _py = [Market Sales Value PY]
    RETURN
        IF ( NOT ISBLANK ( _py ), DIVIDE ( _cy - _py, _py ) )

// Change in the number of market sales on the same period a year earlier.
// Format: +0.0%;-0.0%;0.0%
[Market Sales YoY %] =
    VAR _cy = [Market Sales]
    VAR _py = CALCULATE ( [Market Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
    RETURN
        IF ( NOT ISBLANK ( _py ), DIVIDE ( _cy - _py, _py ) )

// Clean market sales: the population for price statistics (no quality flag).
// Format: #,0
[Clean Sales] = SUM ( 'Area Month'[Clean Sales] )

// The middle price per square metre: half of sales were cheaper, half dearer. Calculation: median of AED per sq m over clean market sales; blank if fewer than 20 sales. Source: Transactions. Caveat: mixes property types; compare like with like using the price index.
// Format: "AED "#,0
[Median Price per Sq M] =
    VAR _n = CALCULATE ( COUNTROWS ( 'Transactions' ), KEEPFILTERS ( 'Transactions'[Is Clean Market Sale] = TRUE () ) )
    RETURN
        IF (
            _n >= [Min N],
            CALCULATE (
                MEDIAN ( 'Transactions'[Price per Sq M AED] ),
                KEEPFILTERS ( 'Transactions'[Is Clean Market Sale] = TRUE () )
            )
        )

// Median AED per sq m in thousands ("18K"; the visual title says AED), so all bedroom columns of the zone matrix fit. A measure, not a scaling format string: those render literally.
// Format: #,0"K"
[Median Price per Sq M (K)] = DIVIDE ( [Median Price per Sq M], 1000 )

// The average price per square metre of apartments and villas, weighting big homes by their size. Calculation: total sale value divided by total floor area of clean apartment and villa sales. Source: Area Month. Caveat: only meaningful for homes; land and whole buildings are left out.
// Format: "AED "#,0
[Area-Weighted Price per Sq M (Homes)] =
    CALCULATE (
        DIVIDE ( SUM ( 'Area Month'[Clean Sales Value AED] ), SUM ( 'Area Month'[Clean Sales Area Sq M] ) ),
        KEEPFILTERS ( 'Area Month'[Property Type Key] IN { 101, 102 } )
    )

// Off-plan market sales (reg_type).
// Format: #,0
[Off-Plan Sales] = CALCULATE ( [Market Sales], KEEPFILTERS ( 'Area Month'[Is Off-Plan] = TRUE () ) )

// The share of sales that were homes bought before they were built. Calculation: off-plan market sales divided by all market sales. Source: Area Month.
// Format: 0.0%
[Off-Plan Share (Count)] = DIVIDE ( [Off-Plan Sales], [Market Sales] )

// The share of money spent on homes bought before they were built. Calculation: off-plan sales value divided by all market sales value. Source: Area Month.
// Format: 0.0%
[Off-Plan Share (Value)] = DIVIDE ( CALCULATE ( [Market Sales Value], KEEPFILTERS ( 'Area Month'[Is Off-Plan] = TRUE () ) ), [Market Sales Value] )

// Grey strip under Sales value: the same total split into ready and off-plan sales, in AED billions (the tile label says so). Calculation: Market Sales Value with Is Off-Plan = false / true. Source: Area Month.
[Sales Value Split] =
    VAR _ready = CALCULATE ( [Market Sales Value], KEEPFILTERS ( 'Area Month'[Is Off-Plan] = FALSE () ) )
    VAR _off = CALCULATE ( [Market Sales Value], KEEPFILTERS ( 'Area Month'[Is Off-Plan] = TRUE () ) )
    RETURN
        "Ready " & FORMAT ( _ready / 1e9, "#,0" ) & " · Off-plan " & FORMAT ( _off / 1e9, "#,0" )

// Grey strip under Market sales: ready and off-plan sales counted separately. Calculation: Ready Market Sales and Off-Plan Sales. Source: Area Month.
[Market Sales Split] = "Ready " & FORMAT ( [Ready Market Sales] / 1000, "#,0" ) & "k · Off-plan " & FORMAT ( [Off-Plan Sales] / 1000, "#,0" ) & "k"

// Grey strip under Median AED / sq m: the same median for apartments and for villas / townhouses (blank under 20 clean sales). Calculation: Median Price per Sq M with the property type fixed. Source: Transactions.
[Median Price Split] =
    VAR _apt = CALCULATE ( [Median Price per Sq M], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 101 )
    VAR _villa = CALCULATE ( [Median Price per Sq M], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 102 )
    RETURN
        "Apt " & FORMAT ( _apt / 1000, "#,0.0" ) & "k · Villa " & FORMAT ( _villa / 1000, "#,0.0" ) & "k"

// Grey strip under Off-plan share of value: the share by number of sales, which is higher because off-plan homes are cheaper on average. Calculation: Off-Plan Share (Count). Source: Area Month.
[Off-Plan Share Split] = "By number of sales " & FORMAT ( [Off-Plan Share (Count)], "0%" )

// Grey strip under Off-plan share (count): the share by value, lower because off-plan homes are cheaper on average.
[Off-Plan Value Split] = "By value " & FORMAT ( [Off-Plan Share (Value)], "0%" )

// Grey strip under AED / sq m (homes): the same area-weighted price for apartments and for villas (thousands).
[Area-Weighted Price Split] =
    VAR _apt = CALCULATE ( [Area-Weighted Price per Sq M (Homes)], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 101 )
    VAR _villa = CALCULATE ( [Area-Weighted Price per Sq M (Homes)], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 102 )
    RETURN
        "Apt " & FORMAT ( _apt / 1000, "#,0.0" ) & "k · Villa " & FORMAT ( _villa / 1000, "#,0.0" ) & "k"

// ---------- Financing ----------

// How many finished homes were sold on the open market. Calculation: count of market sales that are not off-plan. Source: Area Month.
// Format: #,0
[Ready Market Sales] = CALCULATE ( [Market Sales], KEEPFILTERS ( 'Area Month'[Is Off-Plan] = FALSE () ) )

// Ready market sales matched to a same-day purchase mortgage of the same unit (a lower bound on bank financing).
// Format: #,0
[Purchase Mortgages] = SUM ( 'Area Month'[Purchase Mortgages] )

// The share of finished-home purchases paid for partly with a bank loan. Calculation: ready sales matched to a mortgage on the same unit the same day, divided by all ready sales. Source: Area Month. Caveat: a lower bound: loans registered later or not matched are missed (in 2025 between 28% matched and 48% for all ready-unit mortgages).
// Format: 0.0%
[Purchase Mortgage Share] = DIVIDE ( [Purchase Mortgages], [Ready Market Sales] )

// Ready market sales with no matched purchase mortgage at registration (not 'cash': some are financed later or not matched).
// Format: #,0
[Ready Sales Not Bank-Financed] = [Ready Market Sales] - [Purchase Mortgages]

// Individual new mortgages, incl. refinancing and off-plan pre-registration; portfolio mortgages excluded.
// Format: #,0
[New Mortgages] = SUM ( 'Area Month'[New Mortgages] )

// How many new home loans were registered for every 100 market sales. Calculation: new individual mortgages (including refinancing) times 100, divided by market sales. Source: Area Month. Caveat: a secondary indicator; refinancing and off-plan loans are included.
// Format: #,0.0
[New Mortgages per 100 Sales] = DIVIDE ( [New Mortgages], [Market Sales] ) * 100

// Loan amount of individual new mortgages.
// Format: "AED "#,0
[New Mortgage Loans] = SUM ( 'Area Month'[New Mortgage Loans AED] )

// Portfolio (bulk) mortgage registrations, counted once per deal; reported separately.
// Format: #,0
[Portfolio Mortgage Deals] = SUM ( 'Area Month'[Portfolio Mortgage Deals] )

// Portfolio mortgage value, once per deal.
// Format: "AED "#,0
[Portfolio Mortgage Value] = SUM ( 'Area Month'[Portfolio Mortgage Value AED] )

// Median loan / price of matched purchase mortgages (observed LTV).
// Format: 0.0%
[Median Purchase LTV] = MEDIAN ( 'Transactions'[Purchase LTV] )

// Grey strip under Mortgage share: the matched purchase loans and the ready sales behind the share. Calculation: Purchase Mortgages and Ready Market Sales. Source: Area Month.
[Mortgage Share Split] = FORMAT ( [Purchase Mortgages] / 1000, "#,0.0" ) & "k loans · " & FORMAT ( [Ready Market Sales] / 1000, "#,0.0" ) & "k sales"

// Grey strip under Ready sales: how many had no matched mortgage at registration (thousands).
[Ready Sales Split] = "Not bank-financed " & FORMAT ( [Ready Sales Not Bank-Financed] / 1000, "#,0.0" ) & "k"

// Grey strip under New mortgages per 100 sales: the number of new mortgages (thousands).
[New Mortgages Split] = FORMAT ( [New Mortgages] / 1000, "#,0.0" ) & "k new mortgages"

// ---------- Rates ----------

// Effective Fed Funds rate, monthly average (decimal).
// Format: 0.00%
[Fed Funds Rate] = AVERAGE ( 'Rates Monthly'[Fed Funds Rate] )

// EIBOR 3 months. Blank until a CBUAE file is loaded (docs/08 Phase 1).
// Format: 0.00%
[EIBOR 3M] = AVERAGE ( 'Rates Monthly'[EIBOR 3M] )

// The interest rate that drives mortgage costs. Calculation: monthly average of EIBOR 3 months when loaded, otherwise the US Fed Funds rate. Source: Rates Monthly. Caveat: EIBOR is not loaded yet, so the Fed Funds rate stands in for it (the dirham is pegged to the dollar).
// Format: 0.00%
[Reference Rate] =
    VAR _eibor = [EIBOR 3M]
    RETURN
        IF ( NOT ISBLANK ( _eibor ), _eibor, [Fed Funds Rate] )

// Names the series [Reference Rate] shows, for the visual title.
[Reference Rate Label] =
    IF (
        ISBLANK ( CALCULATE ( [EIBOR 3M], REMOVEFILTERS ( 'Date' ) ) ),
        "Fed Funds rate (EIBOR proxy)",
        "EIBOR 3M"
    )

// Grey strip under Reference rate: which series is shown (EIBOR, or Fed Funds as its proxy).
[Reference Rate Split] = IF ( ISBLANK ( CALCULATE ( [EIBOR 3M], REMOVEFILTERS ( 'Date' ) ) ), "Fed Funds (EIBOR proxy)", "EIBOR 3 months" )

// ---------- Prices ----------

// The index segment chosen on the Price Index segment slicer; Dubai when none.
[Selected Index Segment] = SELECTEDVALUE ( 'Price Index'[Segment], "Dubai (all residential)" )

// Hedonic index (Jan 2019 = 100) of the selected segment, on the Date axis (the table is disconnected; TREATAS maps dates to periods).
// Format: 0.0
[Index Value] =
    VAR _seg = [Selected Index Segment]
    RETURN
        CALCULATE (
            SUM ( 'Price Index'[Index Value] ),
            'Price Index'[Segment] = _seg,
            TREATAS ( VALUES ( 'Date'[Date] ), 'Price Index'[Period Start] )
        )

// The selected segment's latest complete (non-partial) period on or before the end of the date selection.
// Format: mmm yyyy
[Index Latest Complete Period] =
    VAR _seg = [Selected Index Segment]
    RETURN
        CALCULATE (
            MAX ( 'Price Index'[Period Start] ),
            'Price Index'[Segment] = _seg,
            'Price Index'[Is Partial Period] = FALSE (),
            TREATAS ( VALUES ( 'Date'[Date] ), 'Price Index'[Period Start] )
        )

// The level of like-for-like prices, with January 2019 set to 100. Calculation: the hedonic price index of the chosen segment at the latest complete month. Source: Price Index. Caveat: 150 means prices are 50% above January 2019 for comparable homes.
// Format: 0.0
[Index Value (Latest Complete)] =
    VAR _seg = [Selected Index Segment]
    VAR _p = [Index Latest Complete Period]
    RETURN
        CALCULATE ( SUM ( 'Price Index'[Index Value] ), 'Price Index'[Segment] = _seg, 'Price Index'[Period Start] = _p )

// How much prices changed over a year for comparable homes. Calculation: the hedonic price index at the latest complete month against the same month a year earlier. Source: Price Index. Caveat: the newest months are revised as late sales arrive.
// Format: +0.0%;-0.0%;0.0%
[Index YoY] =
    VAR _seg = [Selected Index Segment]
    VAR _p = [Index Latest Complete Period]
    RETURN
        CALCULATE ( SUM ( 'Price Index'[YoY Change] ), 'Price Index'[Segment] = _seg, 'Price Index'[Period Start] = _p )

// How far prices are below their previous high. Calculation: the index at the latest complete month divided by its running peak, minus 1. Source: Price Index. Caveat: 0% means prices are at a peak.
// Format: 0.0%
[Drawdown from Peak] =
    VAR _seg = [Selected Index Segment]
    VAR _p = [Index Latest Complete Period]
    RETURN
        CALCULATE ( SUM ( 'Price Index'[Drawdown] ), 'Price Index'[Segment] = _seg, 'Price Index'[Period Start] = _p )

// Line: drawdown from the running peak per period, for the drawdown chart.
// Format: 0.0%
[Index Drawdown] =
    VAR _seg = [Selected Index Segment]
    RETURN
        CALCULATE (
            SUM ( 'Price Index'[Drawdown] ),
            'Price Index'[Segment] = _seg,
            TREATAS ( VALUES ( 'Date'[Date] ), 'Price Index'[Period Start] )
        )

// Deepest fall from a running peak in the date selection (all history when no Year is selected).
// Format: 0.0%
[Max Drawdown] =
    VAR _seg = [Selected Index Segment]
    RETURN
        CALCULATE (
            MIN ( 'Price Index'[Drawdown] ),
            'Price Index'[Segment] = _seg,
            TREATAS ( VALUES ( 'Date'[Date] ), 'Price Index'[Period Start] )
        )

// DLD's official index, rebased to Jan 2019 = 100, for the selected segment (ends May 2024; leads/lags: reports/price_index.md).
// Format: 0.0
[DLD Index Value] =
    CALCULATE (
        SUM ( 'DLD Price Index'[DLD Index Value] ),
        TREATAS ( { [Selected Index Segment] }, 'DLD Price Index'[Segment] ),
        TREATAS ( VALUES ( 'Date'[Date] ), 'DLD Price Index'[Period Start] )
    )

// Hedonic apartment index (Jan 2019 = 100) for the mix-shift chart.
// Format: 0.0
[Index Value (Apartments)] =
    CALCULATE (
        SUM ( 'Price Index'[Index Value] ),
        'Price Index'[Segment] = "Apartments",
        TREATAS ( VALUES ( 'Date'[Date] ), 'Price Index'[Period Start] )
    )

// Raw median AED per sq m of clean residential apartment sales, blank under min-n: what a median shows before mix adjustment.
// Format: "AED "#,0
[Raw Median Price per Sq M (Apartments)] = CALCULATE ( [Median Price per Sq M], KEEPFILTERS ( 'Transactions'[Property Type Key] = 101 ) )

// Raw apartment median rebased to Jan 2019 = 100 (the index base month, config.INDEX_BASE_MONTH), so it sits on the hedonic index's axis: the gap is the mix shift.
// Format: 0.0
[Raw Median Rebased (Apartments)] =
    VAR _base =
        CALCULATE (
            [Raw Median Price per Sq M (Apartments)],
            REMOVEFILTERS ( 'Date' ),
            'Date'[Month Start] = DATE ( 2019, 1, 1 )
        )
    RETURN
        DIVIDE ( [Raw Median Price per Sq M (Apartments)], _base ) * 100

// Grey strip under Prices YoY: the like-for-like change for apartments and for villas / townhouses at the latest complete month. Calculation: Index YoY with the index segment fixed. Source: Price Index.
[Index YoY Split] =
    VAR _apt = CALCULATE ( [Index YoY], 'Price Index'[Segment] = "Apartments" )
    VAR _villa = CALCULATE ( [Index YoY], 'Price Index'[Segment] = "Villas / Townhouses" )
    RETURN
        "Apt " & FORMAT ( _apt, "+0.0%;-0.0%" ) & " · Villa " & FORMAT ( _villa, "+0.0%;-0.0%" )

// Grey strip under Index: the latest complete month the index value refers to.
[Index Period Split] = "Latest complete month: " & FORMAT ( [Index Latest Complete Period], "mmm yyyy" )

// Grey strip under Below previous peak: the deepest fall of the selected index since 2011 (all years, Year slicer ignored).
[Max Drawdown Split] = "Deepest since 2011 " & FORMAT ( CALCULATE ( [Max Drawdown], REMOVEFILTERS ( 'Date' ) ), "0.0%" )

// ---------- Yields ----------

// The yearly rent a home earns as a share of its price. Calculation: median new rent divided by median price for matching groups of homes, averaged by sales over the last four complete quarters. Source: Yield Quarter. Caveat: before service charges, empty months and fees; groups with fewer than 20 rents or sales, or outside 2% to 15%, are left out.
// Format: 0.0%
[Gross Yield (Latest 4 Quarters)] =
    VAR _lastQ =
        CALCULATE (
            MAX ( 'Yield Quarter'[Quarter Start] ),
            REMOVEFILTERS ( 'Yield Quarter' ),
            'Yield Quarter'[Is Partial Period] = FALSE ()
        )
    VAR _cells =
        CALCULATETABLE (
            'Yield Quarter',
            'Yield Quarter'[Geo Level] = "Zone",
            'Yield Quarter'[Is Outside Sanity Band] = FALSE (),
            'Yield Quarter'[Is Partial Period] = FALSE (),
            'Yield Quarter'[Quarter Start] > EDATE ( _lastQ, -12 ),
            'Yield Quarter'[Quarter Start] <= _lastQ,
            TREATAS ( VALUES ( 'Area'[Zone] ), 'Yield Quarter'[Zone] ),
            TREATAS ( VALUES ( 'Property Type'[Property Type Key] ), 'Yield Quarter'[Property Type Key] ),
            TREATAS ( VALUES ( 'Bedrooms'[Bedrooms Key] ), 'Yield Quarter'[Bedrooms] )
        )
    RETURN
        DIVIDE ( SUMX ( _cells, 'Yield Quarter'[Gross Yield] * 'Yield Quarter'[Sales] ), SUMX ( _cells, 'Yield Quarter'[Sales] ) )

// Area-level cells (n >= min-n on both sides) for the map; most areas only reach min-n at zone level, so many are blank.
// Format: 0.0%
[Gross Yield by Area (Latest 4 Quarters)] =
    VAR _lastQ =
        CALCULATE (
            MAX ( 'Yield Quarter'[Quarter Start] ),
            REMOVEFILTERS ( 'Yield Quarter' ),
            'Yield Quarter'[Is Partial Period] = FALSE ()
        )
    VAR _cells =
        CALCULATETABLE (
            'Yield Quarter',
            'Yield Quarter'[Geo Level] = "Area",
            'Yield Quarter'[Is Outside Sanity Band] = FALSE (),
            'Yield Quarter'[Is Partial Period] = FALSE (),
            'Yield Quarter'[Quarter Start] > EDATE ( _lastQ, -12 ),
            'Yield Quarter'[Quarter Start] <= _lastQ,
            TREATAS ( VALUES ( 'Area'[Area Key] ), 'Yield Quarter'[Area Key] ),
            TREATAS ( VALUES ( 'Property Type'[Property Type Key] ), 'Yield Quarter'[Property Type Key] ),
            TREATAS ( VALUES ( 'Bedrooms'[Bedrooms Key] ), 'Yield Quarter'[Bedrooms] )
        )
    RETURN
        DIVIDE ( SUMX ( _cells, 'Yield Quarter'[Gross Yield] * 'Yield Quarter'[Sales] ), SUMX ( _cells, 'Yield Quarter'[Sales] ) )

// Trend: sales-weighted zone-cell yield per quarter on the Date axis (complete quarters only).
// Format: 0.0%
[Gross Yield by Quarter] =
    CALCULATE (
        DIVIDE (
            SUMX ( 'Yield Quarter', 'Yield Quarter'[Gross Yield] * 'Yield Quarter'[Sales] ),
            SUM ( 'Yield Quarter'[Sales] )
        ),
        'Yield Quarter'[Geo Level] = "Zone",
        'Yield Quarter'[Is Outside Sanity Band] = FALSE (),
        'Yield Quarter'[Is Partial Period] = FALSE (),
        TREATAS ( VALUES ( 'Date'[Date] ), 'Yield Quarter'[Quarter Start] ),
        TREATAS ( VALUES ( 'Area'[Zone] ), 'Yield Quarter'[Zone] ),
        TREATAS ( VALUES ( 'Property Type'[Property Type Key] ), 'Yield Quarter'[Property Type Key] ),
        TREATAS ( VALUES ( 'Bedrooms'[Bedrooms Key] ), 'Yield Quarter'[Bedrooms] )
    )

// For the yield vs growth scatter: the zone x type index's change over the 3 years to its latest complete period. Needs one zone and one property type in context.
// Format: +0.0%;-0.0%;0.0%
[Index Growth 3Y (Zone)] =
    VAR _zone = SELECTEDVALUE ( 'Area'[Zone] )
    VAR _type = SELECTEDVALUE ( 'Property Type'[Property Type Key] )
    VAR _rows =
        CALCULATETABLE (
            'Price Index',
            REMOVEFILTERS ( 'Price Index' ),
            'Price Index'[Segment Level] = "Zone",
            'Price Index'[Zone] = _zone,
            'Price Index'[Property Type Key] = _type
        )
    VAR _last = MAXX ( FILTER ( _rows, 'Price Index'[Is Partial Period] = FALSE () ), 'Price Index'[Period Start] )
    VAR _now = MAXX ( FILTER ( _rows, 'Price Index'[Period Start] = _last ), 'Price Index'[Index Value] )
    VAR _then = MAXX ( FILTER ( _rows, 'Price Index'[Period Start] = EDATE ( _last, -36 ) ), 'Price Index'[Index Value] )
    RETURN
        IF ( NOT ISBLANK ( _then ), DIVIDE ( _now, _then ) - 1 )

// How many new rent contracts were signed. Calculation: count of new, comparable rent contracts. Source: Rent Month. Caveat: renewals are left out because they lag the market.
// Format: #,0
[New Market Rents] = SUM ( 'Rent Month'[Market Rent Contracts] )

// The yearly rent per square metre of new apartment and villa leases. Calculation: total annual rent divided by total floor area of new contracts with a plausible size. Source: Rent Month.
// Format: "AED "#,0
[Area-Weighted New Rent per Sq M (Homes)] =
    CALCULATE (
        DIVIDE ( SUM ( 'Rent Month'[Comparable Rent with Area AED] ), SUM ( 'Rent Month'[Comparable Area Sq M] ) ),
        KEEPFILTERS ( 'Rent Month'[Is New Contract] = TRUE () ),
        KEEPFILTERS ( 'Rent Month'[Property Type Key] IN { 101, 102 } )
    )

// Area-weighted annual rent per sq m of new comparable contracts in context (any property type in the filter; compare within one class).
// Format: "AED "#,0
[New Rent per Sq M] =
    CALCULATE (
        DIVIDE ( SUM ( 'Rent Month'[Comparable Rent with Area AED] ), SUM ( 'Rent Month'[Comparable Area Sq M] ) ),
        KEEPFILTERS ( 'Rent Month'[Is New Contract] = TRUE () )
    )

// Grey strip under Gross yield: the same yield for apartments and for villas / townhouses.
[Yield Split] =
    VAR _apt = CALCULATE ( [Gross Yield (Latest 4 Quarters)], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 101 )
    VAR _villa = CALCULATE ( [Gross Yield (Latest 4 Quarters)], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 102 )
    RETURN
        "Apt " & FORMAT ( _apt, "0.0%" ) & " · Villa " & FORMAT ( _villa, "0.0%" )

// Grey strip under New rent contracts: apartments and villas / townhouses (thousands).
[New Rents Split] =
    VAR _apt = CALCULATE ( [New Market Rents], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 101 )
    VAR _villa = CALCULATE ( [New Market Rents], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 102 )
    RETURN
        "Apt " & FORMAT ( _apt / 1000, "#,0" ) & "k · Villa " & FORMAT ( _villa / 1000, "#,0" ) & "k"

// Grey strip under New rent per sq m (homes): apartments and villas / townhouses (AED per sq m per year).
[Rent per Sq M Split] =
    VAR _apt = CALCULATE ( [Area-Weighted New Rent per Sq M (Homes)], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 101 )
    VAR _villa = CALCULATE ( [Area-Weighted New Rent per Sq M (Homes)], REMOVEFILTERS ( 'Property Type' ), 'Property Type'[Property Type Key] = 102 )
    RETURN
        "Apt " & FORMAT ( _apt, "#,0" ) & " · Villa " & FORMAT ( _villa, "#,0" )

// ---------- Valuation ----------

// How far the automated valuation typically is from the real price. Calculation: median absolute error, as a share of the price, on 2025 to 2026 sales the model never saw. Source: AVM Performance. Caveat: compare with the comparable-sales baseline shown underneath.
// Format: 0.00%
[AVM Test MdAPE] =
    CALCULATE (
        MAX ( 'AVM Performance'[MdAPE] ),
        'AVM Performance'[Model] = "lightgbm",
        'AVM Performance'[Split] = "Test",
        'AVM Performance'[Breakdown] = "Overall"
    )

// The share of homes the automated valuation got within 10% of the real price. Calculation: test sales with an error of 10% or less, divided by all test sales valued. Source: AVM Performance.
// Format: 0.0%
[AVM Test Hit Rate 10%] =
    CALCULATE (
        MAX ( 'AVM Performance'[Hit Rate 10 Pct] ),
        'AVM Performance'[Model] = "lightgbm",
        'AVM Performance'[Split] = "Test",
        'AVM Performance'[Breakdown] = "Overall"
    )

// The share of homes the automated valuation got within 20% of the real price. Calculation: test sales with an error of 20% or less, divided by all test sales valued. Source: AVM Performance.
// Format: 0.0%
[AVM Test Hit Rate 20%] =
    CALCULATE (
        MAX ( 'AVM Performance'[Hit Rate 20 Pct] ),
        'AVM Performance'[Model] = "lightgbm",
        'AVM Performance'[Split] = "Test",
        'AVM Performance'[Breakdown] = "Overall"
    )

// Comparable-sales baseline (6 months) on the same test set.
// Format: 0.00%
[AVM Test MdAPE (Baseline)] =
    CALCULATE (
        MAX ( 'AVM Performance'[MdAPE] ),
        'AVM Performance'[Model] = "comps",
        'AVM Performance'[Split] = "Test",
        'AVM Performance'[Breakdown] = "Overall"
    )

// Baseline share within ±10%.
// Format: 0.0%
[AVM Test Hit Rate 10% (Baseline)] =
    CALCULATE (
        MAX ( 'AVM Performance'[Hit Rate 10 Pct] ),
        'AVM Performance'[Model] = "comps",
        'AVM Performance'[Split] = "Test",
        'AVM Performance'[Breakdown] = "Overall"
    )

// Baseline share within ±20%.
// Format: 0.0%
[AVM Test Hit Rate 20% (Baseline)] =
    CALCULATE (
        MAX ( 'AVM Performance'[Hit Rate 20 Pct] ),
        'AVM Performance'[Model] = "comps",
        'AVM Performance'[Split] = "Test",
        'AVM Performance'[Breakdown] = "Overall"
    )

// Percentage points of MdAPE the model saves against comparable sales (positive = better).
// Format: 0.00%
[AVM MdAPE Gain vs Baseline] = [AVM Test MdAPE (Baseline)] - [AVM Test MdAPE]

// MdAPE of one model x segment row of AVM Performance (for the accuracy-by-segment bar; filter Split and Breakdown on the visual).
// Format: 0.00%
[AVM Segment MdAPE] =
    IF (
        HASONEVALUE ( 'AVM Performance'[Model] ) && HASONEVALUE ( 'AVM Performance'[Segment] ),
        MAX ( 'AVM Performance'[MdAPE] )
    )

// Out-of-sample sales the AVM valued in context.
// Format: #,0
[Valued Sales] = COUNTROWS ( 'AVM Score' )

// MdAPE recomputed for the current slicers (out-of-sample rows), blank under min-n.
// Format: 0.00%
[AVM MdAPE (Interactive)] = IF ( [Valued Sales] >= [Min N], MEDIAN ( 'AVM Score'[Absolute Error Pct] ) )

// Share within ±10% for the current slicers, blank under min-n.
// Format: 0.0%
[AVM Hit Rate 10% (Interactive)] =
    IF (
        [Valued Sales] >= [Min N],
        DIVIDE ( CALCULATE ( COUNTROWS ( 'AVM Score' ), KEEPFILTERS ( 'AVM Score'[Absolute Error Pct] <= 0.10 ) ), [Valued Sales] )
    )

// Median sale price of the valued sales (actual line of actual vs AVM).
// Format: "AED "#,0
[Median Sale Price (AVM Sample)] = IF ( [Valued Sales] >= [Min N], MEDIAN ( 'AVM Score'[Price AED] ) )

// Median AVM value of the same sales (predicted line).
// Format: "AED "#,0
[Median AVM Value] = IF ( [Valued Sales] >= [Min N], MEDIAN ( 'AVM Score'[AVM Value AED] ) )

// Median (price - AVM) / AVM: positive = sold above the AVM. Blank under min-n.
// Format: +0.0%;-0.0%;0.0%
[Median Gap %] = IF ( [Valued Sales] >= [Min N], MEDIAN ( 'AVM Score'[Gap Pct] ) )

// Sales more than 25% from their AVM value: statistical anomalies for collateral review, not accusations.
// Format: #,0
[Flagged for Review] = CALCULATE ( COUNTROWS ( 'AVM Score' ), KEEPFILTERS ( 'AVM Score'[Review Flag] = "Review: statistical anomaly" ) )

// Flagged for review / valued sales.
// Format: 0.0%
[Flagged Share] = DIVIDE ( [Flagged for Review], [Valued Sales] )

// Mean |SHAP| of a feature, in log points of the predicted price (0.05 ≈ 5%).
// Format: 0.000
[Mean Abs SHAP] = SUM ( 'Feature Importance'[Mean Abs SHAP] )

// How many 2025 to 2026 sales the automated valuation was tested on. Calculation: count of test sales the model could value. Source: AVM Performance. Caveat: these sales were never used to train the model.
// Format: #,0
[AVM Test Sales Valued] =
    CALCULATE (
        MAX ( 'AVM Performance'[Sales Valued] ),
        'AVM Performance'[Model] = "lightgbm",
        'AVM Performance'[Split] = "Test",
        'AVM Performance'[Breakdown] = "Overall"
    )

// Grey strip under AVM median error: the comparable-sales baseline on the same test set.
[AVM MdAPE Split] = "Comparables " & FORMAT ( [AVM Test MdAPE (Baseline)], "0.00%" )

// Grey strip under Within 10%: the comparable-sales baseline.
[AVM Hit 10 Split] = "Comparables " & FORMAT ( [AVM Test Hit Rate 10% (Baseline)], "0.0%" )

// Grey strip under Within 20%: the comparable-sales baseline.
[AVM Hit 20 Split] = "Comparables " & FORMAT ( [AVM Test Hit Rate 20% (Baseline)], "0.0%" )

// Grey strip under Test sales valued: the share flagged for review (more than 25% from the AVM; anomalies, not accusations).
[AVM Flagged Split] = "Flagged for review " & FORMAT ( [Flagged Share], "0.0%" )

// ---------- Risk ----------

// Price Shock % slicer value (integer percent); -20 when none.
// Format: 0
[Selected Shock] = SELECTEDVALUE ( 'Price Shock %'[Price Shock %], -20 )

// LTV % slicer value (50/60/70/80/85); 80 when none.
// Format: 0
[Selected LTV] = SELECTEDVALUE ( 'LTV %'[LTV %], 80 )

// Stress segment (Stress Grid[Segment] slicer); Dubai when none. Use for Dubai / type / zone levels: area names repeat, so areas go through the Area-based measure.
[Selected Stress Segment] = SELECTEDVALUE ( 'Stress Grid'[Segment], "Dubai (all residential)" )

// Ready / Off-Plan slicer; Ready when none. Off-plan is never pooled with ready.
[Selected Ready / Off-Plan] = SELECTEDVALUE ( 'Ready Off-Plan'[Ready / Off-Plan], "Ready" )

// The share of recent buyers who would owe more than their home is worth after the chosen price fall. Calculation: purchases of the last three years whose loan exceeds the home's value after the shock, at the chosen loan-to-value. Source: Stress Grid. Caveat: illustrative, not a regulatory stress test; loans are kept at their starting size.
// Format: 0.0%
[Negative Equity Share] =
    VAR _seg = [Selected Stress Segment]
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _shock = [Selected Shock]
    VAR _ltv = [Selected LTV]
    RETURN
        CALCULATE (
            SELECTEDVALUE ( 'Stress Grid'[Negative Equity Share] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = _seg,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = "Price shock",
            'Stress Grid'[Loan Basis] = "Assumed LTV",
            'Stress Grid'[Shock Pct] = _shock,
            'Stress Grid'[LTV Pct] = _ltv
        )

// Loan in excess of the shocked value, summed over buyers in negative equity (upper bound: no amortisation).
// Format: "AED "#,0
[Negative Equity AED] =
    VAR _seg = [Selected Stress Segment]
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _shock = [Selected Shock]
    VAR _ltv = [Selected LTV]
    RETURN
        CALCULATE (
            SUM ( 'Stress Grid'[Negative Equity AED] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = _seg,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = "Price shock",
            'Stress Grid'[Loan Basis] = "Assumed LTV",
            'Stress Grid'[Shock Pct] = _shock,
            'Stress Grid'[LTV Pct] = _ltv
        )

// Buyers in negative equity for the selection.
// Format: #,0
[Negative Equity Count] =
    VAR _seg = [Selected Stress Segment]
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _shock = [Selected Shock]
    VAR _ltv = [Selected LTV]
    RETURN
        CALCULATE (
            SUM ( 'Stress Grid'[Negative Equity Count] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = _seg,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = "Price shock",
            'Stress Grid'[Loan Basis] = "Assumed LTV",
            'Stress Grid'[Shock Pct] = _shock,
            'Stress Grid'[LTV Pct] = _ltv
        )

// Recent clean residential purchases in the stressed segment.
// Format: #,0
[Stress Purchases] =
    VAR _seg = [Selected Stress Segment]
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _shock = [Selected Shock]
    VAR _ltv = [Selected LTV]
    RETURN
        CALCULATE (
            SUM ( 'Stress Grid'[Purchases] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = _seg,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = "Price shock",
            'Stress Grid'[Loan Basis] = "Assumed LTV",
            'Stress Grid'[Shock Pct] = _shock,
            'Stress Grid'[LTV Pct] = _ltv
        )

// The same negative-equity share if every buyer had borrowed the most the central bank allows. Calculation: as Negative Equity Share, with each loan at the CBUAE cap on its sale date (expatriate, first home). Source: Stress Grid. Caveat: illustrative; nationality and first or second home are not in the data.
// Format: 0.0%
[Negative Equity Share (CBUAE Cap)] =
    VAR _seg = [Selected Stress Segment]
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _shock = [Selected Shock]
    RETURN
        CALCULATE (
            SELECTEDVALUE ( 'Stress Grid'[Negative Equity Share] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = _seg,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = "Price shock",
            'Stress Grid'[Loan Basis] = "CBUAE cap (expatriate, first home)",
            'Stress Grid'[Shock Pct] = _shock
        )

// Reference: the registered loans of matched purchases (a lower-bound subset), at the selected shock.
// Format: 0.0%
[Negative Equity Share (Registered Loans)] =
    VAR _seg = [Selected Stress Segment]
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _shock = [Selected Shock]
    RETURN
        CALCULATE (
            SELECTEDVALUE ( 'Stress Grid'[Negative Equity Share] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = _seg,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = "Price shock",
            'Stress Grid'[Loan Basis] = "Registered loan (matched purchases)",
            'Stress Grid'[Shock Pct] = _shock
        )

// The share of recent buyers who would owe more than their home is worth if the 2014 to 2020 fall happened again. Calculation: each purchase marked down by the 2014 to 2020 fall (Dubai-wide by default), at the chosen loan-to-value. Source: Stress Grid. Caveat: illustrative; the own-series version (in the strip) is the upper range.
// Format: 0.0%
[Replay Negative Equity Share] =
    VAR _seg = [Selected Stress Segment]
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _ltv = [Selected LTV]
    VAR _scenario = SELECTEDVALUE ( 'Replay Depth'[Scenario], "Replay: 2014-2020, Dubai-wide" )
    RETURN
        CALCULATE (
            SELECTEDVALUE ( 'Stress Grid'[Negative Equity Share] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = _seg,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = _scenario,
            'Stress Grid'[Loan Basis] = "Assumed LTV",
            'Stress Grid'[LTV Pct] = _ltv
        )

// Map / bar: the area-level grid row for each Area in context, the property type chosen on the slicer (apartments when none or several), at the selected shock and LTV. Blank under min-n.
// Format: 0.0%
[Negative Equity Share by Area] =
    VAR _type = SELECTEDVALUE ( 'Property Type'[Property Type Key], 101 )
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _shock = [Selected Shock]
    VAR _ltv = [Selected LTV]
    RETURN
        CALCULATE (
            SELECTEDVALUE ( 'Stress Grid'[Negative Equity Share] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment Level] = "Area",
            TREATAS ( VALUES ( 'Area'[Area Key] ), 'Stress Grid'[Area Key] ),
            'Stress Grid'[Property Type Key] = _type,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = "Price shock",
            'Stress Grid'[Loan Basis] = "Assumed LTV",
            'Stress Grid'[Shock Pct] = _shock,
            'Stress Grid'[LTV Pct] = _ltv
        )

// 2014-2020 drawdown of each index series in the replay (Stress Replay; deeper on noisier zone series).
// Format: 0.0%
[Replay Drawdown] = MIN ( 'Stress Replay'[Drawdown] )

// Grey strip under In negative equity: the shortfall in AED billions (loans above the shocked value).
[Negative Equity Split] = "Shortfall AED " & FORMAT ( [Negative Equity AED] / 1e9, "#,0.0" ) & "bn"

// Grey strip under At the CBUAE cap: the same share for the registered loans of matched purchases.
[CBUAE Cap Split] = "Registered loans " & FORMAT ( [Negative Equity Share (Registered Loans)], "0.0%" )

// Grey strip under 2014-20 replay: the upper range, each buyer's own zone series.
[Replay Split] =
    VAR _seg = [Selected Stress Segment]
    VAR _ro = [Selected Ready / Off-Plan]
    VAR _ltv = [Selected LTV]
    VAR _own =
        CALCULATE (
            SELECTEDVALUE ( 'Stress Grid'[Negative Equity Share] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = _seg,
            'Stress Grid'[Ready / Off-Plan] = _ro,
            'Stress Grid'[Scenario] = "Replay: 2014-2020, own series",
            'Stress Grid'[Loan Basis] = "Assumed LTV",
            'Stress Grid'[LTV Pct] = _ltv
        )
    RETURN
        "Own series (upper) " & FORMAT ( _own, "0%" )

// ---------- Risk\Concentration ----------

// Off-plan market sale lines on Transactions (needed per project; equals Off-Plan Sales).
// Format: #,0
[Off-Plan Market Sales (Lines)] =
    CALCULATE (
        COUNTROWS ( 'Transactions' ),
        KEEPFILTERS ( 'Transactions'[Is Market Sale] = TRUE () ),
        KEEPFILTERS ( 'Transactions'[Is Off-Plan] = TRUE () )
    )

// A master project's share of off-plan market sales among known master projects.
// Format: 0.0%
[Master Project Share (Off-Plan)] =
    VAR _all =
        CALCULATE (
            [Off-Plan Market Sales (Lines)],
            REMOVEFILTERS ( 'Project' ),
            NOT ISBLANK ( 'Project'[Master Project] ),
            'Project'[Master Project] <> "Unknown"
        )
    RETURN
        DIVIDE ( [Off-Plan Market Sales (Lines)], _all )

// How concentrated off-plan sales are in the largest master projects. Calculation: off-plan sales of the 10 biggest master projects divided by all off-plan sales with a known master project. Source: Transactions and Project. Caveat: a proxy for developer concentration; developer names need the DLD projects file.
// Format: 0.0%
[Top 10 Master Project Share (Off-Plan)] =
    VAR _mp =
        ADDCOLUMNS (
            FILTER (
                ALL ( 'Project'[Master Project] ),
                NOT ISBLANK ( 'Project'[Master Project] ) && 'Project'[Master Project] <> "Unknown"
            ),
            "@sales", [Off-Plan Market Sales (Lines)]
        )
    VAR _total = SUMX ( _mp, [@sales] )
    RETURN
        DIVIDE ( SUMX ( TOPN ( 10, _mp, [@sales], DESC ), [@sales] ), _total )

// PROXY: Herfindahl-Hirschman index over master projects' shares of off-plan market sales (0-10,000; above 1,500 = moderately concentrated by the usual competition thresholds).
// Format: #,0
[Master Project HHI (Off-Plan)] =
    VAR _mp =
        ADDCOLUMNS (
            FILTER (
                ALL ( 'Project'[Master Project] ),
                NOT ISBLANK ( 'Project'[Master Project] ) && 'Project'[Master Project] <> "Unknown"
            ),
            "@sales", [Off-Plan Market Sales (Lines)]
        )
    VAR _total = SUMX ( _mp, [@sales] )
    RETURN
        SUMX ( _mp, POWER ( DIVIDE ( [@sales], _total ), 2 ) ) * 10000

// Grey strip under Top-10 master projects: the HHI over master projects (a proxy).
[Concentration Split] = "HHI " & FORMAT ( [Master Project HHI (Off-Plan)], "#,0" ) & " (proxy)"

// ---------- Risk\Outlook ----------

// Central path of the selected rate scenario.
// Format: #,0.0
[Forecast Central] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    RETURN
        CALCULATE (
            SUM ( 'Forecast'[Forecast] ),
            'Forecast'[Segment] = _seg,
            'Forecast'[Target] = _target,
            'Forecast'[Scenario] = _scenario
        )

// 80% interval, lower bound (assumes the model is right; backtest coverage on the Forecast Backtest table).
// Format: #,0.0
[Forecast Lower 80] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    RETURN
        CALCULATE (
            SUM ( 'Forecast'[Lower 80] ),
            'Forecast'[Segment] = _seg,
            'Forecast'[Target] = _target,
            'Forecast'[Scenario] = _scenario
        )

// 80% interval, upper bound.
// Format: #,0.0
[Forecast Upper 80] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    RETURN
        CALCULATE (
            SUM ( 'Forecast'[Upper 80] ),
            'Forecast'[Segment] = _seg,
            'Forecast'[Target] = _target,
            'Forecast'[Scenario] = _scenario
        )

// 95% interval, lower bound.
// Format: #,0.0
[Forecast Lower 95] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    RETURN
        CALCULATE (
            SUM ( 'Forecast'[Lower 95] ),
            'Forecast'[Segment] = _seg,
            'Forecast'[Target] = _target,
            'Forecast'[Scenario] = _scenario
        )

// 95% interval, upper bound.
// Format: #,0.0
[Forecast Upper 95] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    RETURN
        CALCULATE (
            SUM ( 'Forecast'[Upper 95] ),
            'Forecast'[Segment] = _seg,
            'Forecast'[Target] = _target,
            'Forecast'[Scenario] = _scenario
        )

// Actual index or volume to the last complete month (the history line of the fan chart).
// Format: #,0.0
[Forecast Actual] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    RETURN
        CALCULATE (
            SUM ( 'Forecast'[Actual] ),
            'Forecast'[Segment] = _seg,
            'Forecast'[Target] = _target,
            'Forecast'[Scenario] = "Actual"
        )

// Where like-for-like prices could be in 12 months on the central path. Calculation: SARIMAX forecast at the end of the horizon against the last actual month, rates flat. Source: Forecast. Caveat: a statistical baseline, not a call; the range in the strip matters as much.
// Format: +0.0%;-0.0%;0.0%
[Forecast 12M Change] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    VAR _lastActual =
        CALCULATE ( MAX ( 'Forecast'[Month] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = "Actual" )
    VAR _actual =
        CALCULATE ( SUM ( 'Forecast'[Actual] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = "Actual", 'Forecast'[Month] = _lastActual )
    VAR _lastForecast =
        CALCULATE ( MAX ( 'Forecast'[Month] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = _scenario )
    VAR _end =
        CALCULATE ( SUM ( 'Forecast'[Forecast] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = _scenario, 'Forecast'[Month] = _lastForecast )
    RETURN
        DIVIDE ( _end, _actual ) - 1

// 80% band, lower end, vs the last actual.
// Format: +0.0%;-0.0%;0.0%
[Forecast 12M Lower 80] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    VAR _lastActual =
        CALCULATE ( MAX ( 'Forecast'[Month] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = "Actual" )
    VAR _actual =
        CALCULATE ( SUM ( 'Forecast'[Actual] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = "Actual", 'Forecast'[Month] = _lastActual )
    VAR _lastForecast =
        CALCULATE ( MAX ( 'Forecast'[Month] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = _scenario )
    VAR _end =
        CALCULATE ( SUM ( 'Forecast'[Lower 80] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = _scenario, 'Forecast'[Month] = _lastForecast )
    RETURN
        DIVIDE ( _end, _actual ) - 1

// 80% band, upper end, vs the last actual.
// Format: +0.0%;-0.0%;0.0%
[Forecast 12M Upper 80] =
    VAR _seg = SELECTEDVALUE ( 'Forecast'[Segment], "Dubai (all residential)" )
    VAR _target = SELECTEDVALUE ( 'Forecast'[Target], "Price index" )
    VAR _scenario = SELECTEDVALUE ( 'Forecast Scenario'[Scenario], "Rates flat" )
    VAR _lastActual =
        CALCULATE ( MAX ( 'Forecast'[Month] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = "Actual" )
    VAR _actual =
        CALCULATE ( SUM ( 'Forecast'[Actual] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = "Actual", 'Forecast'[Month] = _lastActual )
    VAR _lastForecast =
        CALCULATE ( MAX ( 'Forecast'[Month] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = _scenario )
    VAR _end =
        CALCULATE ( SUM ( 'Forecast'[Upper 80] ), REMOVEFILTERS ( 'Forecast' ), 'Forecast'[Segment] = _seg, 'Forecast'[Target] = _target, 'Forecast'[Scenario] = _scenario, 'Forecast'[Month] = _lastForecast )
    RETURN
        DIVIDE ( _end, _actual ) - 1

// Card subtitle: the 80% band as text.
[Forecast 12M Band 80% Label] = FORMAT ( [Forecast 12M Lower 80], "+0.0%;-0.0%" ) & " to " & FORMAT ( [Forecast 12M Upper 80], "+0.0%;-0.0%" )

// Grey strip under Outlook: the 80% range of the 12-month change.
[Forecast Split] = "80%: " & [Forecast 12M Band 80% Label]

// ---------- Report\Guide ----------

// Introduction: what the data covers, with the live counts and the snapshot date.
[Guide Data Line] =
    VAR _asOf = MAX ( 'Report Info'[Data As Of] )
    VAR _sales = CALCULATE ( [Market Sales], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ) )
    VAR _rents = CALCULATE ( [New Market Rents], REMOVEFILTERS ( 'Area' ), REMOVEFILTERS ( 'Property Type' ), REMOVEFILTERS ( 'Bedrooms' ), REMOVEFILTERS ( 'Ready Off-Plan' ), REMOVEFILTERS ( 'Date' ) )
    RETURN
        "Every property sale and rent contract registered with the Dubai Land Department from 2004 to "
            & FORMAT ( _asOf, "d mmmm yyyy" ) & ": " & FORMAT ( _sales, "#,0" ) & " market sales and "
            & FORMAT ( _rents, "#,0" ) & " new rent contracts. Public open data (CC BY 4.0)."

// Key terms: today's like-for-like price change for Dubai, as a live example of the price index.
[Guide Index Line] =
    VAR _yoy = CALCULATE ( [Index YoY], REMOVEFILTERS ( 'Date' ), 'Price Index'[Segment] = "Dubai (all residential)" )
    VAR _period = CALCULATE ( [Index Latest Complete Period], REMOVEFILTERS ( 'Date' ), 'Price Index'[Segment] = "Dubai (all residential)" )
    RETURN
        "Like-for-like prices in Dubai: " & FORMAT ( _yoy, "+0.0%;-0.0%" ) & " on a year earlier (" & FORMAT ( _period, "mmmm yyyy" ) & ")."

// Key terms: how the AVM was tested and how accurate it was, from the model card numbers.
[Guide AVM Line] =
    "Learned from 2011 to 2023 sales, then valued " & FORMAT ( [AVM Test Sales Valued], "#,0" ) & " sales from 2025 to 2026 it never saw. Typical error "
        & FORMAT ( [AVM Test MdAPE], "0.0%" ) & ", against " & FORMAT ( [AVM Test MdAPE (Baseline)], "0.0%" ) & " for recent nearby sales."

// Key terms: one worked stress-test result (ready buyers, Dubai, prices -20%, 80% loans), slicers ignored.
[Guide Stress Line] =
    VAR _share =
        CALCULATE (
            SELECTEDVALUE ( 'Stress Grid'[Negative Equity Share] ),
            REMOVEFILTERS ( 'Stress Grid' ),
            'Stress Grid'[Segment] = "Dubai (all residential)",
            'Stress Grid'[Ready / Off-Plan] = "Ready",
            'Stress Grid'[Scenario] = "Price shock",
            'Stress Grid'[Loan Basis] = "Assumed LTV",
            'Stress Grid'[Shock Pct] = -20,
            'Stress Grid'[LTV Pct] = 80
        )
    RETURN
        "If prices fell 20%, about " & FORMAT ( _share, "0%" )
            & " of recent ready buyers with an 80% loan would owe more than the home is worth."

// Key terms: the 12-month outlook for Dubai prices with its 80% range (rates flat), as a live example.
[Guide Forecast Line] =
    "Dubai prices over the next 12 months: " & FORMAT ( [Forecast 12M Change], "+0%;-0%" ) & " on the central path, 80% range "
        & FORMAT ( [Forecast 12M Lower 80], "+0%;-0%" ) & " to " & FORMAT ( [Forecast 12M Upper 80], "+0%;-0%" ) & "."
