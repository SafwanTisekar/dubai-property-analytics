        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5f6673"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#e3e5ea"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#5f6673"
              }
            },
            "fontSize": 9
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2
          }
        ]
