    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1b2a4a"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5f6673"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#1b2a4a"
              }
            },
            "transparency": 0
          }
