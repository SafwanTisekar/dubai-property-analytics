model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Transactions", "Area Month", "Rent Month", "Rates Monthly", "Date", "Area", "Property Type", "Procedure", "Project", "Bedrooms", "Ready Off-Plan", "Price Index", "DLD Price Index", "Yield Quarter", "AVM Score", "AVM Performance", "Feature Importance", "Stress Grid", "Stress Replay", "Forecast", "Forecast Backtest", "Report Info", "PgServer", "PgDatabase"]

annotation PBI_ProTooling = ["DevMode"]

ref table Transactions
ref table 'Area Month'
ref table 'Rent Month'
ref table 'Rates Monthly'
ref table Date
ref table Area
ref table 'Property Type'
ref table Procedure
ref table Project
ref table Bedrooms
ref table 'Ready Off-Plan'
ref table 'Price Index'
ref table 'DLD Price Index'
ref table 'Yield Quarter'
ref table 'AVM Score'
ref table 'AVM Performance'
ref table 'Feature Importance'
ref table 'Stress Grid'
ref table 'Stress Replay'
ref table Forecast
ref table 'Forecast Backtest'
ref table 'Report Info'
ref table 'Price Shock %'
ref table 'LTV %'
ref table 'Replay Depth'
ref table 'Forecast Scenario'
ref table _Measures
ref table 'KPI Guide'

ref cultureInfo en-US
