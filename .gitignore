# --- Data (never committed: DLD raw files are multi-GB) -----------------------
# Ignore everything under data/, but keep directories traversable so the
# README notes in each raw folder (dataset schema notes) stay tracked.
/data/**
!/data/**/
!/data/raw/**/README.txt

# CI fixtures are committed (tests/fixtures/README.md); the loader's manifest export isn't.
/tests/fixtures/manifest.json

# --- Secrets ------------------------------------------------------------------
.env
.env.*
!.env.example

# --- Trained model binaries (large, reproducible via `make train`) ------------
# Everything under artifacts/ is ignored except the AVM's tuned parameters (7 KB): with
# them a rebuild skips the 20-trial Optuna study and reproduces the published model
# (owner, 2026-10-01). A directory can't be re-included once ignored, hence /* patterns.
/artifacts/*
!/artifacts/avm/
/artifacts/avm/*
!/artifacts/avm/best_params.json

# --- Outputs of runs against a scratch / fixture database (db.reports_dir) -----
# Only the main database (config.MAIN_DB) writes the committed reports/*.md and figures.
/reports/scratch/

# --- Database dumps -----------------------------------------------------------
*.dump
*.backup
*.sql.gz

# --- Python / uv ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- dbt ------------------------------------------------------------------------
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/
.user.yml

# --- Power BI (PBIP local/cache files) ----------------------------------------
# cache.abf is the imported data (tens of MB); localSettings.json is per-user.
# The PBIP definition (TMDL, report JSON, .platform, editorSettings.json) is committed.
**/.pbi/cache.abf
**/.pbi/localSettings.json
*.abf

# --- OS / editors ---------------------------------------------------------------
.DS_Store
.vscode/
.idea/
.claude/
